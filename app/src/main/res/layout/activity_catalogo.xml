<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fondo_principal">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@color/fondo_encabezado"
        android:elevation="@dimen/elevacion_media"
        android:padding="@dimen/padding_medio">

        <ImageView
            android:layout_width="@dimen/logo_size"
            android:layout_height="@dimen/logo_size"
            android:layout_marginBottom="@dimen/margin_pequeno"
            android:background="@drawable/borde_azul"
            android:contentDescription="@string/logo_app"
            android:padding="@dimen/padding_pequeno"
            android:src="@drawable/ic_android"
            app:tint="@color/icono_contraste"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_minimo"
            android:text="@string/app_name"
            android:textColor="@color/texto_principal"
            android:textSize="@dimen/texto_titulo"
            android:textStyle="bold"/>

    </LinearLayout>

    <LinearLayout
        style="?android:attr/buttonBarStyle"
        android:layout_width="@dimen/contenedor_botones"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/margin_pequeno"
        android:orientation="horizontal"
        android:padding="@dimen/padding_pequeno">

        <Button
            android:id="@+id/btnVolver"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/margin_minimo"
            android:layout_weight="1"
            android:backgroundTint="@color/boton_secundario"
            android:elevation="@dimen/elevacion_baja"
            android:padding="@dimen/padding_boton"
            android:text="@string/volver"
            android:textColor="@color/texto_boton"/>

        <Button
            android:id="@+id/btnCarrito"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_minimo"
            android:layout_weight="1"
            android:backgroundTint="@color/boton_principal"
            android:elevation="@dimen/elevacion_baja"
            android:padding="@dimen/padding_boton"
            android:text="@string/carrito"
            android:textColor="@color/texto_boton"/>

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerProductos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="@dimen/padding_recycler"/>

</LinearLayout>