<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="vertical"
        android:gravity="center"
        android:padding="@dimen/padding_large"
        android:background="@color/primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/ic_android"
            android:background="@drawable/borde_purpura"
            android:padding="@dimen/padding_medium"
            android:contentDescription="@string/icono_admin"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_small"
            android:text="@string/panel_admin"
            android:textColor="@color/texto_blanco"
            android:textSize="@dimen/text_title"
            android:textStyle="bold"/>

    </LinearLayout>

    <LinearLayout
        android:orientation="vertical"
        android:padding="@dimen/padding_default"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <Button
            android:id="@+id/btnVolver"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/volver"
            android:textColor="@color/texto_blanco"
            android:backgroundTint="@color/boton_oscuro"/>

        <LinearLayout
            android:orientation="vertical"
            android:background="@color/card_background"
            android:elevation="@dimen/elevation_default"
            android:padding="@dimen/padding_medium"
            android:layout_marginTop="@dimen/margin_medium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/txtTotalVentas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ventas_default"
                android:textStyle="bold"
                android:textSize="@dimen/text_subtitle"
                android:textColor="@color/texto_principal"/>

            <TextView
                android:id="@+id/txtTotalPedidos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pedidos_default"
                android:textColor="@color/texto_principal"/>

            <TextView
                android:id="@+id/txtPagados"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pagados_default"
                android:textColor="@color/texto_principal"/>

            <TextView
                android:id="@+id/txtPendientes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pendientes_default"
                android:textColor="@color/texto_principal"/>

        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerVentas"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/margin_small"
            android:layout_weight="1"/>

    </LinearLayout>

</LinearLayout>