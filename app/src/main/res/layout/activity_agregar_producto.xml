<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <EditText
        android:id="@+id/etNombre"
        android:hint="@string/hint_nombre_producto"
        android:autofillHints="name"
        android:inputType="textPersonName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <EditText
        android:id="@+id/etPrecio"
        android:hint="@string/hint_precio"
        android:inputType="numberDecimal"
        android:autofillHints="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <EditText
        android:id="@+id/etDescripcion"
        android:hint="@string/hint_descripcion"
        android:inputType="textMultiLine"
        android:autofillHints="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <EditText
        android:id="@+id/etImagenUrl"
        android:hint="@string/hint_imagen_url"
        android:inputType="textUri"
        android:autofillHints="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <Button
        android:id="@+id/btnImagen"
        android:text="@string/seleccionar_imagen"
        android:textColor="@color/white"
        android:backgroundTint="@color/primary"
        android:layout_marginTop="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <Button
        android:id="@+id/btnGuardar"
        android:text="@string/guardar_producto"
        android:textColor="@color/white"
        android:backgroundTint="@color/verde"
        android:layout_marginTop="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <Button
        android:id="@+id/btnVolver"
        android:text="@string/volver"
        android:textColor="@color/white"
        android:backgroundTint="@color/accent"
        android:layout_marginTop="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

</LinearLayout>