<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_principal">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <ImageView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_marginBottom="16dp"
            android:background="@color/logo_background"
            android:contentDescription="@string/app_logo"
            android:padding="12dp"
            android:src="@drawable/ic_android"
            app:tint="@color/logo_tint" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="@string/app_name"
            android:textColor="@color/texto_principal"
            android:textSize="22sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etEmail"
            android:layout_width="280dp"
            android:layout_height="48dp"
            android:layout_marginBottom="12dp"
            android:autofillHints="emailAddress"
            android:hint="@string/correo"
            android:inputType="textEmailAddress"
            android:padding="10dp"
            android:textColor="@color/texto_principal"
            android:textColorHint="@color/texto_hint" />

        <EditText
            android:id="@+id/etPassword"
            android:layout_width="280dp"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp"
            android:autofillHints="password"
            android:hint="@string/password"
            android:inputType="textPassword"
            android:padding="10dp"
            android:textColor="@color/texto_principal"
            android:textColorHint="@color/texto_hint" />

        <Button
            android:id="@+id/btnLogin"
            android:layout_width="240dp"
            android:layout_height="48dp"
            android:text="@string/login"
            android:textColor="@color/texto_boton"
            android:backgroundTint="@color/boton_primario" />

        <Button
            android:id="@+id/btnRecuperar"
            android:layout_width="240dp"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="@string/olvide_password"
            android:textColor="@color/texto_boton"
            android:backgroundTint="@color/boton_secundario" />

        <Button
            android:id="@+id/btnHuella"
            android:layout_width="240dp"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="@string/huella"
            android:textColor="@color/texto_boton"
            android:backgroundTint="@color/boton_huella" />

        <Button
            android:id="@+id/btnIrRegistro"
            android:layout_width="240dp"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="@string/crear_cuenta"
            android:textColor="@color/texto_boton"
            android:backgroundTint="@color/boton_registro" />

    </LinearLayout>

</ScrollView>